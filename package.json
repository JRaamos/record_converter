{
  "name": "record-converter",
  "version": "1.0.0",
  "description": "Conversão local de formulários S-21 para CSV compatível",
  "author": "Record Converter contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:packaged": "node scripts/verify-package.cjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test:electron": "playwright test -c tests/electron.config.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "tech.febraio.recordconverter",
    "productName": "Record Converter",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "Record-Converter-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Record-Converter-Portable-${version}.${ext}"
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.utilities"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
